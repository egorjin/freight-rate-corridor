POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=deals_bigdata
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host port for the Compose database. 5432 is often already taken by a system Postgres.
POSTGRES_PUBLISH_PORT=5433

# Snapshot date from the task. Train/test bounds are derived from this.
AS_OF_DATE=2026-10-26

# Inclusive loading_date window replaced on each ETL run.
ETL_START_DATE=2019-01-01
ETL_END_DATE=2027-12-31

RANDOM_SEED=42

# Passed to assignment/sql/synthetic.sql on the first Postgres init only.
N_PRICES=300000

# Bonus profile only (`docker compose --profile bonus up`). Local defaults.
CLICKHOUSE_PASSWORD=corridor
CLICKHOUSE_HTTP_PORT=8123
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__CORE__FERNET_KEY=bG9jYWx0Y29ycmlkb3ItZmVybmV0LWtleS0zMmJ5dGU=
SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_SECRET_KEY=local-corridor-superset-secret
